{
    "name": "ozea-labs/esteira-fixture-php-app",
    "description": "Aplicação mínima que o self-test da esteira usa como consumidor.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": { "Fixture\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Fixture\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true,
        "platform": { "php": "8.4.0" }
    }
}
