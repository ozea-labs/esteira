# Configuração do self-test (o consumidor real usa .github/esteira.env).
PHP_VERSION=8.4
PHP_EXTENSIONS=intl
PHP_COVERAGE=pcov
IMAGE_TARGET=runtime
IMAGE_SMOKE=smoke.sh
# As fixtures de falha existem para reprovar; não entram no Semgrep do próprio repositório.
SEMGREP_EXCLUDES=fixtures/bad fixtures/vuln-image
